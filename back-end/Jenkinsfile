pipeline {
    agent any
    
    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    
    environment {
        REGISTRY = 'muhammadmaulana'
        GO_VERSION = '1.25'
        KUBECONFIG = credentials('kubeconfig')
    }
    
    stages {
        // ========================================
        // Stage 1: Checkout
        // ========================================
        stage('Checkout') {
            steps {
                checkout scm
                echo ' Source code checked out'
            }
        }
        
        // ========================================
        // Stage 2: Unit Tests
        // ========================================
        stage('Unit Tests') {
            agent {
                docker {
                    image "golang:${GO_VERSION}-alpine"
                    args '-e HOME=/tmp -e GOPATH=/tmp/go -e GOCACHE=/tmp/go-cache'
                }
            }
            steps {
                dir('back-end') {
                    sh '''
                        set -e
                        echo "Running unit tests for all services..."
                        
                        SERVICES="user-service payment-service pricing-service order-service \
                                  courier-service dispatch-service hub-service tracking-service \
                                  notification-service resolution-service"
                        
                        for svc in $SERVICES; do
                            echo "=== Testing services/$svc ==="
                            cd services/$svc
                            go test -tags=unit -v -count=1 -coverprofile=../../coverage_${svc}.out ./...
                            cd ../..
                        done
                        
                        echo "=== Testing api-gateway ==="
                        cd api-gateway
                        go test -tags=unit -v -count=1 ./...
                        cd ..
                    '''
                }
                echo ' Unit tests passed'
            }
            post {
                always {
                    publishHTML(target: [
                        allowMissing: true,
                        reportDir: 'back-end',
                        reportFiles: 'coverage_*.out',
                        reportName: 'Test Coverage'
                    ])
                }
            }
        }
        
        // ========================================
        // Stage 3: Lint & Vet
        // ========================================
        stage('Lint & Vet') {
            agent {
                docker {
                    image "golang:${GO_VERSION}-alpine"
                    args '-e HOME=/tmp -e GOPATH=/tmp/go -e GOCACHE=/tmp/go-cache'
                }
            }
            steps {
                dir('back-end') {
                    sh '''
                        set -e
                        echo "Running go vet..."
                        
                        SERVICES="user-service payment-service pricing-service order-service \
                                  courier-service dispatch-service hub-service tracking-service \
                                  notification-service resolution-service"
                        
                        for svc in $SERVICES; do
                            echo "=== Vetting services/$svc ==="
                            cd services/$svc && go vet ./... && cd ../..
                        done
                        
                        cd api-gateway && go vet ./... && cd ..
                    '''
                }
                echo ' Lint & Vet passed'
            }
        }
        
        // ========================================
        // Stage 4: Build Docker Images
        // ========================================
        stage('Build Images') {
            steps {
                dir('back-end') {
                    script {
                        def services = [
                            'user-service', 'payment-service', 'pricing-service', 'order-service',
                            'courier-service', 'dispatch-service', 'hub-service', 'tracking-service',
                            'notification-service', 'resolution-service'
                        ]
                        
                        services.each { svc ->
                            echo "Building ${svc}..."
                            sh """
                                docker build \
                                    --build-arg SERVICE_NAME=${svc} \
                                    -t ${REGISTRY}/${svc}:${env.BUILD_NUMBER} \
                                    -t ${REGISTRY}/${svc}:latest \
                                    -f Dockerfile .
                            """
                        }
                        
                        // Build API Gateway separately
                        sh """
                            docker build \
                                --build-arg SERVICE_NAME=../api-gateway \
                                -t ${REGISTRY}/api-gateway:${env.BUILD_NUMBER} \
                                -t ${REGISTRY}/api-gateway:latest \
                                -f Dockerfile .
                        """
                    }
                }
                echo ' Docker images built'
            }
        }
        
        // ========================================
        // Stage 5: Functional Tests
        // ========================================
        stage('Functional Tests') {
            steps {
                dir('back-end') {
                    sh '''
                        echo "Starting infrastructure for functional tests..."
                        docker-compose up -d postgres mongodb redis kafka zookeeper
                        
                        echo "Waiting for services to be healthy..."
                        sleep 30
                        
                        echo "Running functional tests..."
                        SERVICES="user-service payment-service order-service"
                        
                        for svc in $SERVICES; do
                            echo "=== Functional testing services/$svc ==="
                            cd services/$svc
                            go test -tags=functional -v -count=1 ./...
                            cd ../..
                        done
                        
                        echo "Cleaning up..."
                        docker-compose down -v
                    '''
                }
                echo ' Functional tests passed'
            }
        }
        
        // ========================================
        // Stage 6: Push Images
        // ========================================
        stage('Push Images') {
            when {
                anyOf {
                    branch 'main'
                    branch 'joko'
                }
            }
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', 'dockerhub-credentials') {
                        def services = [
                            'user-service', 'payment-service', 'pricing-service', 'order-service',
                            'courier-service', 'dispatch-service', 'hub-service', 'tracking-service',
                            'notification-service', 'resolution-service', 'api-gateway'
                        ]
                        
                        services.each { svc ->
                            sh "docker push ${REGISTRY}/${svc}:${env.BUILD_NUMBER}"
                            sh "docker push ${REGISTRY}/${svc}:latest"
                        }
                    }
                }
                echo ' Images pushed to registry'
            }
        }
        
        // ========================================
        // Stage 7: Update Helm Values (GitOps)
        // ========================================
        stage('Update GitOps Repo') {
            when {
                anyOf {
                    branch 'main'
                    branch 'joko'
                }
            }
            steps {
                dir('back-end') {
                    sh """
                        echo "Updating Helm values.yaml with new image tag..."
                        # Simple sed to replace the image tag in values.yaml
                        sed -i 's/tag: .*/tag: "${env.BUILD_NUMBER}"/' deployments/helm/nusaroute/values.yaml
                        
                        git config user.email "jenkins@nusaroute.internal"
                        git config user.name "Jenkins CI"
                        
                        git add deployments/helm/nusaroute/values.yaml
                        git commit -m "ci: update image tag to ${env.BUILD_NUMBER} [skip ci]" || echo "No changes to commit"
                        
                        # Note: In a real environment, this requires SSH keys or Git credentials
                        # git push origin main
                        echo " Updated GitOps repository with new image tag ${env.BUILD_NUMBER}"
                    """
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {
            cleanWs()
        }
    }
}
